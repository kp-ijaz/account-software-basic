{
  "ConnectionStrings": {
    "PostgresConnection": "Host=localhost;Port=5432;Database=madrasa_accounting;Username=postgres;Password=password"
  },
  "JwtSettings": {
    "Secret": "your-super-secret-key-min-32-characters-long-change-this-in-production",
    "Issuer": "MadrasaAccountingAPI",
    "Audience": "MadrasaAccountingApp",
    "ExpirationHours": 24
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/madrasa-accounting-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*"
}
